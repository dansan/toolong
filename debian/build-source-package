#!/bin/sh
# Build the source package (.dsc and tarballs) for the version in
# debian/changelog from git HEAD and the PyPI sdists of the textual and rich
# versions in HEAD's poetry.lock.
# Usage: debian/build-source-package [OUTPUT_DIR]   (default: ..)
set -eu

cd "$(dirname "$0")/.."
out=$(realpath "${1:-..}")
upstream=$(dpkg-parsechangelog -S Version | sed 's/-[^-]*$//')
orig="$out/toolong_$upstream.orig"

git archive --format=tar.gz --prefix="toolong-$upstream/" \
	-o "$orig.tar.gz" HEAD -- . ':(exclude)debian'

# Prints "NAME VERSION SHA256" of the sdist for each package.
locked_sdists() {
	git show HEAD:poetry.lock | python3 -c '
import sys, tomllib
packages = {p["name"]: p for p in tomllib.load(sys.stdin.buffer)["package"]}
for name in sys.argv[1:]:
    p = packages[name]
    sdist = name + "-" + p["version"] + ".tar.gz"
    (digest,) = [f["hash"] for f in p["files"] if f["file"] == sdist]
    print(name, p["version"], digest.removeprefix("sha256:"))
' "$@"
}

sdists=$(locked_sdists textual rich)
echo "$sdists" | while read -r name version sha256; do
	curl -fsSL -o "$orig-$name.tar.gz" \
		"https://files.pythonhosted.org/packages/source/$(echo "$name" | cut -c1)/$name/$name-$version.tar.gz"
	echo "$sha256  $orig-$name.tar.gz" | sha256sum -c --quiet
done

tree=$(mktemp -d)
trap 'rm -rf "$tree"' EXIT
src="$tree/toolong-$upstream"
mkdir "$src" "$src/textual" "$src/rich"
tar -xzf "$orig.tar.gz" -C "$src" --strip-components=1
tar -xzf "$orig-textual.tar.gz" -C "$src/textual" --strip-components=1
tar -xzf "$orig-rich.tar.gz" -C "$src/rich" --strip-components=1
cp -a debian "$src/"
ln -s "$orig"*.tar.gz "$tree/"
(cd "$tree" && dpkg-source -b "toolong-$upstream")
mv "$tree"/*.dsc "$tree"/*.debian.tar.* "$out/"
